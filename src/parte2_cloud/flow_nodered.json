  {
    "id": "cardioia_mqtt_in",
    "type": "mqtt in",
    "z": "cardioia_aba",
    "name": "Assinar leituras",
    "topic": "cardioia/ai4success/leituras",
    "qos": "0",
    "datatype": "json",
    "broker": "cardioia_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 120,
    "wires": [["cardioia_funcao", "cardioia_debug"]]
  },
  {
    "id": "cardioia_funcao",
    "type": "function",
    "z": "cardioia_aba",
    "name": "Separar sinais e avaliar alerta",
    "func": "// Limites definidos para esta simulação, a partir dos exemplos do enunciado.\n// Não são critérios clínicos.\nconst LIMITE_BPM = 120;\nconst LIMITE_TEMPERATURA = 38;\n\nconst leitura = msg.payload;\n\n// Ignora mensagens fora do formato publicado pelo ESP32\nif (leitura === null || typeof leitura !== 'object' ||\n    typeof leitura.bpm !== 'number' || typeof leitura.temperatura !== 'number') {\n    node.warn('Mensagem ignorada: formato inesperado');\n    return null;\n}\n\nconst motivos = [];\nif (leitura.bpm > LIMITE_BPM) {\n    motivos.push('BPM ' + leitura.bpm + ' acima de ' + LIMITE_BPM);\n}\nif (leitura.temperatura > LIMITE_TEMPERATURA) {\n    motivos.push('Temperatura ' + leitura.temperatura.toFixed(1) + ' °C acima de ' + LIMITE_TEMPERATURA + ' °C');\n}\n\nconst alerta = {\n    payload: {\n        ativo: motivos.length > 0,\n        texto: motivos.length > 0 ? 'ALERTA: ' + motivos.join(' | ') : 'Sem alerta',\n        momento: leitura.momento\n    }\n};\n\n// Saídas: 1 = gráfico de BPM, 2 = gauge de temperatura, 3 = alerta\nreturn [\n    { topic: 'BPM', payload: leitura.bpm },\n    { topic: 'Temperatura', payload: leitura.temperatura },\n    alerta\n];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 120,
    "wires": [["cardioia_grafico"], ["cardioia_gauge"], ["cardioia_alerta"]]
  },
  {
    "id": "cardioia_debug",
    "type": "debug",
    "z": "cardioia_aba",
    "name": "Mensagem recebida",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 380,
    "y": 200,
    "wires": []
  },
  {
    "id": "cardioia_grafico",
    "type": "ui_chart",
