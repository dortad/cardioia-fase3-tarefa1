  },
  {
    "id": "cardioia_alerta",
    "type": "ui_template",
    "z": "cardioia_aba",
    "group": "cardioia_ui_grupo",
    "name": "Indicador de alerta",
    "order": 3,
    "width": "6",
    "height": "4",
    "format": "<div style=\"text-align:center; padding:8px\">\n  <div ng-style=\"{'background-color': msg.payload.ativo ? '#ca3838' : '#00b500'}\"\n       style=\"width:64px; height:64px; border-radius:50%; margin:0 auto 12px auto\"></div>\n  <div style=\"font-size:18px; font-weight:bold\">{{msg.payload.texto || 'Aguardando leituras'}}</div>\n  <div style=\"font-size:12px; margin-top:8px\">Dados simulados, sem uso clínico</div>\n</div>\n",
    "storeOutMessages": true,
